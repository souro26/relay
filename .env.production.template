# ==============================================================================
# Relay Production Environment Template
# Copy this file to .env.production on your production server.
# NEVER commit the filled .env.production file to version control.
# ==============================================================================

# Application environment (production enforces strict security constraints)
ENVIRONMENT=production

# Database Credentials
# Generate a strong password: openssl rand -hex 24
POSTGRES_USER=relay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=relay_production

# PostgreSQL connection URL for application services (internal Docker network)
DATABASE_URL=postgresql+psycopg://relay:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/relay_production

# Application Logging (JSON formatted logs for production observability)
LOG_LEVEL=INFO

# Simulated Order Management Service
ORDER_SERVICE_URL=http://order-service:8001
ORDER_SERVICE_TIMEOUT=10.0

# LLM Provider Configuration
# Supported providers: nvidia (NVIDIA NIM) or openai
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=CHANGE_ME_NVIDIA_API_KEY
# Custom NIM base URL if using self-hosted NIM:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT=60.0

# LLM Budget & Operational Controls
LLM_MAX_INPUT_CHARS=2000
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_BASE=1.0

# Cost Telemetry Pricing (USD per 1,000,000 tokens)
LLM_INPUT_COST_PER_MILLION=0.50
LLM_OUTPUT_COST_PER_MILLION=1.50

# Demo Access Control / API Key Protection
# If set, clients must supply 'X-Demo-Key: <key>' to use NL interpretation
DEMO_API_KEY=CHANGE_ME_STRONG_API_KEY

# In-Memory Rate Limiting (requests per minute per client IP for NL endpoint)
RATE_LIMIT_PER_MINUTE=60

# Production Domain / Hostname for Reverse Proxy (e.g., relay.example.com)
DOMAIN_NAME=example.com
