# Relay Staging Environment Configuration
# Copy this file to .env.staging and fill in your values
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS

# Application environment: development, staging, production, test
ENVIRONMENT=staging

# PostgreSQL connection URL
# Format: postgresql+psycopg://user:password@host:port/database
# Using psycopg3 driver for better performance
DATABASE_URL=postgresql+psycopg://relay:CHANGE_ME_STAGING_PASSWORD@localhost:5432/relay_staging

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Order Management Service (external simulated service)
# Base URL for the order management service API
ORDER_SERVICE_URL=http://localhost:8001

# HTTP timeout for order service calls (seconds)
ORDER_SERVICE_TIMEOUT=10.0

# LLM Configuration (for natural language interpretation)
# Provider: nvidia (NVIDIA NIM) or openai
LLM_PROVIDER=nvidia

# Model to use (NVIDIA Nemotron 3 Ultra via NIM)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# NVIDIA API Key (required for natural language interpretation with NVIDIA NIM)
# Get yours from https://build.nvidia.com
LLM_API_KEY=CHANGE_ME_NVIDIA_API_KEY

# Optional: Custom NVIDIA NIM base URL (for self-hosted NIM)
# Default: https://integrate.api.nvidia.com/v1
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# HTTP timeout for LLM calls (seconds)
LLM_TIMEOUT=60.0

# LLM Cost Controls
# Maximum input characters for NL requests (prevents oversized prompts)
LLM_MAX_INPUT_CHARS=2000
# Maximum output tokens for LLM responses (provider-dependent)
LLM_MAX_OUTPUT_TOKENS=500
# Maximum retries for failed LLM calls (0 = no retries)
LLM_MAX_RETRIES=1
# Base backoff for retries in seconds (exponential backoff)
LLM_RETRY_BACKOFF_BASE=1.0
# Pricing for estimated cost calculation (USD per 1M tokens)
LLM_INPUT_COST_PER_MILLION=0.50
LLM_OUTPUT_COST_PER_MILLION=1.50

# Demo Access Control
# Shared API key for demo access to NL endpoint (optional, but recommended for public demo)
# If set, clients must provide X-Demo-Key header to access /api/v1/order-change-requests/nl
DEMO_API_KEY=CHANGE_ME_DEMO_API_KEY

# Rate limiting for NL endpoint (requests per minute per IP)
# Note: In-memory limiter; not consistent across multiple instances
RATE_LIMIT_PER_MINUTE=100